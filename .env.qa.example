# RanchOS QA environment for atlas.
# Copy to .env.qa on the server and fill in secrets. Do NOT commit .env.qa.
# Used via: docker compose --env-file .env.qa -f docker-compose.qa.yml up -d --build
#
# The compose file composes DATABASE_URL / auth URLs from these values, so you
# only set the primitives here.

# Postgres (QA database)
POSTGRES_USER=ranchos
POSTGRES_DB=ranchos
POSTGRES_PASSWORD=change-me-strong-qa-password

# Better Auth session signing secret. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-long-random-secret

# Public base URL of the API on atlas (used for auth callbacks + CORS).
PUBLIC_BASE_URL=http://atlas.tail270acc.ts.net:3001
