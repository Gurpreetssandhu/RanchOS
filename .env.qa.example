# RanchOS QA environment for atlas.
# Copy to .env.qa on the server and fill in secrets. Do NOT commit .env.qa.
# Run with:
#   docker compose --env-file .env.qa -f docker-compose.deploy.yml up -d --build
#
# PROD uses the same compose file with a .env.prod that sets a different
# COMPOSE_PROJECT_NAME (separate volume/data), ports, and PUBLIC_WEB_URL.

# Isolation: prefixes containers/network/volume. Keep distinct per environment.
COMPOSE_PROJECT_NAME=ranchos-qa

# Postgres (QA database)
POSTGRES_USER=ranchos
POSTGRES_DB=ranchos
POSTGRES_PASSWORD=change-me-strong-qa-password

# Better Auth session signing secret. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-long-random-secret

# Public, browser-facing URL of the WEB app on atlas (auth + CORS origin).
PUBLIC_WEB_URL=http://atlas.tail270acc.ts.net:3000

# Host port mappings (atlas already uses 5432/8080 elsewhere).
WEB_PORT=3000
API_PORT=3001
PG_PORT=5433
